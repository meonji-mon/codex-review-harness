${USER_HOME}/.claude.json
${USER_HOME}/.opencodex
${USER_HOME}/.opencodex-local
${USER_HOME}/.config
${USER_HOME}/Library/Application Support/Claude-3p/configLibrary/_meta.json
${USER_HOME}/Pictures
