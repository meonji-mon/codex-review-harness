{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${USER_HOME}/.claude/hooks/harness/git-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${USER_HOME}/.claude/hooks/harness/impact-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}